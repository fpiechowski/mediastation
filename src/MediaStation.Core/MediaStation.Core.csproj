<Project Sdk="Microsoft.NET.Sdk">

  <!-- AD-3: Core jest czystym net10.0 — bez UseWPF, WebView2, Microsoft.Windows.* ani I/O plikowego. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>MediaStation.Core</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!--
    Granica Core (AD-3) egzekwowana w kompilacji: zakazane API z BannedSymbols.txt dają RS0030,
    a TreatWarningsAsErrors łamie build. Uzupełnia to CoreBoundaryTests (metadane assembly).
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="BannedSymbols.txt" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>MediaStation</AssemblyName>
    <RootNamespace>MediaStation.App</RootNamespace>
    <!-- Potrzebne tylko na `&guid` w RegisterPowerSettingNotification (CsWin32 chce Guid*). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.363" PrivateAssets="all" />
    <PackageReference Include="System.Management" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="Platform\System\NativeMethods.txt" />
    <!-- R4 (AD-14, AD-15): wywołania okienne tylko w Platform/Window; RS0030 + TreatWarningsAsErrors łamią build. Wyjątek folderu: Platform/Window/.editorconfig. -->
    <AdditionalFiles Include="BannedSymbols.txt" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MediaStation.Core\MediaStation.Core.csproj" />
  </ItemGroup>

  <!-- Nazwy narzucone przez zamrożone kontrakty (Consistency Conventions): aliasy wygrywają z BCL/WPF. -->
  <ItemGroup>
    <Using Include="MediaStation.Core.Contracts.Action" Alias="Action" />
    <Using Include="MediaStation.Core.Contracts.InputMode" Alias="InputMode" />
  </ItemGroup>

  <!--
    Build web jako target MSBuild (AD-13, AD-16): budowa MediaStation.Core.Tests w tym samym przebiegu MSBuild →
    test Category=SchemaExport (eksport schematów, bez własnego exe, bo Application Control blokuje świeże niepodpisane pliki) →
    npm ci (gdy brak node_modules) → npm run contracts:generate →
    Debug: typecheck (shell z Vite dev servera), inne konfiguracje: npm run build:shell i web/shell/dist → <exe>/shell →
    każda konfiguracja: npm run build:page i web/page/dist/runtime.js → <exe>/page/runtime.js.
    Uwaga: nigdy osobny proces budujący (dotnet build lub dotnet test bez opcji no-build) w tym targecie: wyścig o bin/obj przy buildzie solucji.
  -->
  <PropertyGroup>
    <MediaStationRepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\'))</MediaStationRepoRoot>
    <MediaStationWebDir>$(MediaStationRepoRoot)web\</MediaStationWebDir>
    <MediaStationShellDist>$(MediaStationWebDir)shell\dist\</MediaStationShellDist>
    <MediaStationPageRuntime>$(MediaStationWebDir)page\dist\runtime.js</MediaStationPageRuntime>
    <MediaStationCoreTestsProject>$(MediaStationRepoRoot)tests\MediaStation.Core.Tests\MediaStation.Core.Tests.csproj</MediaStationCoreTestsProject>
    <MediaStationShellFromDevServer Condition="'$(Configuration)' == 'Debug'">true</MediaStationShellFromDevServer>
    <DefineConstants Condition="'$(MediaStationShellFromDevServer)' == 'true'">$(DefineConstants);SHELL_DEV_SERVER</DefineConstants>
  </PropertyGroup>

  <!--
    Page bundle (AD-6, AD-13): BrowserHost czyta page\runtime.js i page\drivers\<service>\manifest.json z dysku przy
    każdym starcie, więc pliki trafiają obok exe w buildzie i w publish. Hotfix = podmiana pliku w page\.
    runtime.js to bundle IIFE z web\page\dist (npm run build:page w BuildWeb), dodawany jako Content w targecie.
  -->
  <ItemGroup>
    <!-- SkipWebBuild=true (ręczne npm run build, potem publish): BuildWeb nie działa, więc bundle z dist dodajemy tutaj; bez duplikatu z targetu. -->
    <Content Include="$(MediaStationPageRuntime)" Link="page\runtime.js" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="'$(SkipWebBuild)' == 'true' and Exists('$(MediaStationPageRuntime)')" />
    <Content Include="$(MediaStationWebDir)page\drivers\**\manifest.json" Link="page\drivers\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="BuildWeb" BeforeTargets="BeforeBuild" Condition="'$(DesignTimeBuild)' != 'true' and '$(SkipWebBuild)' != 'true'">
    <MSBuild Projects="$(MediaStationCoreTestsProject)" Targets="Build" Properties="Configuration=$(Configuration)" RemoveProperties="RuntimeIdentifier;SelfContained;PublishDir;PublishReadyToRun;PublishSingleFile;_IsPublishing;TargetFramework" />

    <!-- Zero pasujących testów albo zablokowany host testów = niezerowy kod (MTP: 8) = błąd buildu, bez fallbacku na stare typy. -->
    <Exec Command="dotnet test --project &quot;$(MediaStationCoreTestsProject)&quot; --no-build --no-restore -c $(Configuration) --filter Category=SchemaExport" />

    <!-- npm ci także przy node_modules sprzed esbuild (story 6.6): bez niego build:page nie znajdzie pakietu. -->
    <Exec Command="npm ci" WorkingDirectory="$(MediaStationWebDir)" Condition="!Exists('$(MediaStationWebDir)node_modules') or !Exists('$(MediaStationWebDir)node_modules\esbuild\package.json')" />

    <Exec Command="npm run contracts:generate" WorkingDirectory="$(MediaStationWebDir)" />

    <Exec Command="npm run typecheck" WorkingDirectory="$(MediaStationWebDir)" Condition="'$(MediaStationShellFromDevServer)' == 'true'" />

    <Exec Command="npm run build:shell" WorkingDirectory="$(MediaStationWebDir)" Condition="'$(MediaStationShellFromDevServer)' != 'true'" />

    <ItemGroup Condition="'$(MediaStationShellFromDevServer)' != 'true'">
      <_MediaStationShellFile Include="$(MediaStationShellDist)**\*" />
      <Content Include="@(_MediaStationShellFile)" Link="shell\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>

    <Error Condition="'$(MediaStationShellFromDevServer)' != 'true' and !Exists('$(MediaStationShellDist)index.html')" Text="Build web nie wyprodukował $(MediaStationShellDist)index.html." />

    <!-- PageRuntime (AD-6): bundle esbuild w każdej konfiguracji, bo BrowserHost wstrzykuje go także w Debug. -->
    <Exec Command="npm run build:page" WorkingDirectory="$(MediaStationWebDir)" />

    <ItemGroup>
      <Content Include="$(MediaStationPageRuntime)" Link="page\runtime.js" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>

    <Error Condition="!Exists('$(MediaStationPageRuntime)')" Text="Build web nie wyprodukował $(MediaStationPageRuntime)." />
  </Target>

</Project>

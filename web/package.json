{
  "name": "mediastation-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.22.0"
  },
  "scripts": {
    "contracts:export": "dotnet test --project ../tests/MediaStation.Core.Tests --filter Category=SchemaExport",
    "contracts:generate": "node scripts/contracts.mjs",
    "contracts": "npm run contracts:export && npm run contracts:generate",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "dev": "vite shell",
    "build:shell": "npm run typecheck && vite build shell",
    "build:page": "node scripts/build-page.mjs",
    "build": "npm run contracts && npm run build:shell && npm run build:page"
  },
  "dependencies": {
    "@fontsource-variable/roboto-flex": "5.3.0",
    "@fontsource/material-symbols-rounded": "5.3.9",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "esbuild": "0.28.2",
    "json-schema-to-typescript": "16.0.0",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}

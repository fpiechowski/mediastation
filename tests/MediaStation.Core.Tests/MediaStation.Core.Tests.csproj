<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    <PackageReference Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MediaStation.Core\MediaStation.Core.csproj" />
  </ItemGroup>

  <!--
    Brak projektu testów App (granica epiki), więc typy adaptera bez Win32/WPF są linkowane do testów,
    jak FileLogSink w MediaStation.LogAppendCheck. Shim Win32 (PowerNotifications) zostaje nietestowany.
  -->
  <ItemGroup>
    <Compile Include="..\..\src\MediaStation.App\Orchestrator\OrchestratorLoop.cs" Link="App\OrchestratorLoop.cs" />
    <Compile Include="..\..\src\MediaStation.App\Platform\System\DisplayStateNotification.cs" Link="App\DisplayStateNotification.cs" />
    <Compile Include="..\..\src\MediaStation.App\Platform\System\PowerSignalReporter.cs" Link="App\PowerSignalReporter.cs" />
    <Compile Include="..\..\src\MediaStation.App\Platform\System\WakeSignalGate.cs" Link="App\WakeSignalGate.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="MediaStation.Core.Contracts.Action" Alias="Action" />
    <Using Include="MediaStation.Core.Contracts.InputMode" Alias="InputMode" />
  </ItemGroup>

</Project>

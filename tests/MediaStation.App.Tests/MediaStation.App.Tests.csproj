<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Potrzebne tylko na `&guid` w RegisterPowerSettingNotification (CsWin32 chce Guid*). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.363" PrivateAssets="all" />
    <PackageReference Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="NativeMethods.txt" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MediaStation.Core\MediaStation.Core.csproj" />
  </ItemGroup>

  <!--
    Harness HWND shimu PowerNotifications (DW-1). App to WinExe z buildem web w targecie MSBuild, więc zamiast
    ProjectReference linkujemy pliki adaptera power, jak w MediaStation.Core.Tests. CsWin32 generuje tu własny
    PInvoke z NativeMethods.txt (te same symbole co w App plus to, czego potrzebuje okno testowe).
  -->
  <ItemGroup>
    <Compile Include="..\MediaStation.Core.Tests\RecordingLog.cs" Link="RecordingLog.cs" />
    <Compile Include="..\..\src\MediaStation.App\Platform\System\DisplayStateNotification.cs" Link="App\DisplayStateNotification.cs" />
    <Compile Include="..\..\src\MediaStation.App\Platform\System\PowerNotifications.cs" Link="App\PowerNotifications.cs" />
    <Compile Include="..\..\src\MediaStation.App\Platform\System\PowerSignalReporter.cs" Link="App\PowerSignalReporter.cs" />
    <Compile Include="..\..\src\MediaStation.App\Platform\System\PowerSignalRouter.cs" Link="App\PowerSignalRouter.cs" />
    <Compile Include="..\..\src\MediaStation.App\Platform\System\PowerSourcesAttachment.cs" Link="App\PowerSourcesAttachment.cs" />
    <Compile Include="..\..\src\MediaStation.App\Platform\System\WakeSignalGate.cs" Link="App\WakeSignalGate.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
